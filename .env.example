# ---- Copy this file to .env and fill in values from your IBM Cloud App ID instance ----
# IBM Cloud console -> your App ID service -> "Service Credentials" and "Manage Authentication"

APPID_TENANT_ID=your-tenant-id-here
APPID_CLIENT_ID=your-client-id-here
APPID_SECRET=your-secret-here
APPID_OAUTH_SERVER_URL=https://us-south.appid.cloud.ibm.com/oauth/v4/your-tenant-id-here

# Must EXACTLY match a "Redirect URL" you added in App ID -> Authentication settings
APPID_REDIRECT_URI=http://localhost:3000/ibm/cloud/appid/callback

# Any long random string, used to sign the session cookie
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000
NODE_ENV=development
